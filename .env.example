POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=fastapi_db
DATABASE_URL=postgresql+psycopg://postgres:password@db:5432/fastapi_db
MAX_UPLOAD_MB=50
JWT_SECRET=super-secret-key

ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/fastapi_db

# ── Semantic embedding (S_semantic) ───────────────────────────────────────────
# English MiniLM on ONNX Runtime (via fastembed) — no PyTorch, fits a 2 GB server.
# Leave unset to use this default; override only to try another fastembed model.
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── "Explain duplication" LLM — OPT-IN ────────────────────────────────────────
# Leave LLM_BASE_URL unset (default) → the app uses the grounded, offline TEMPLATE: free, 0 RAM,
# always aligned with the highlights. Enable a provider below only for more fluent wording.
#
# [A] OpenRouter — has genuinely-free models (no prepaid billing), works from Vietnam. RECOMMENDED.
# Free models throttle intermittently (429) → app retries once then uses the template, so it's fine.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key-here          # https://openrouter.ai/keys
# LLM_MODEL=google/gemma-4-26b-a4b-it:free       # verified free 2026-08-15; ":free" list changes over time
#
# [B] Fully-local, offline (needs Ollama running). Tiny model fits ~1 GB next to the ONNX encoder:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:0.5b-instruct
#
# Known NOT to work free from Vietnam (verified): Groq → geo-blocked ("Access denied");
# Google Gemini → no free credits on a plain key ("prepayment credits depleted"), needs billing.
